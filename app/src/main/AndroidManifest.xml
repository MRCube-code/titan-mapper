<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- USB / Bluetooth HID device enumeration (never grants raw data access). -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- Permissions for each tier (see ARCHITECTURE.md §7) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+: special-use foreground service type required for input interception. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Overlay editor floating window (Shizuku / Root tier only). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Vibration for haptic feedback in macros. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- SCHEDULE_EXACT_ALARM intentionally NOT declared: nothing in this app uses AlarmManager.
         WorkManager's own one-time/periodic work (CrashRecoveryWorker) does not need it. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Post notifications (Android 13+) for the persistent service notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the Permissions management screen prompt for battery-optimization exemption, so the
         foreground input service survives OEM background-kill policies ("Run in Background"). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".TitanApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TitanMapper"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Services, AccessibilityService, and BootReceiver are declared in :service's manifest.
             Gradle merges them automatically via manifest merger. -->

        <activity
            android:name=".PermissionsManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.TitanMapper" />

        <activity
            android:name=".ShizukuSetupActivity"
            android:exported="false"
            android:theme="@style/Theme.TitanMapper" />

        <activity
            android:name=".GamesActivity"
            android:exported="false"
            android:theme="@style/Theme.TitanMapper" />

        <!-- TitanApplication supplies its own WorkManager Configuration (so HiltWorkerFactory can
             build @HiltWorker classes like CrashRecoveryWorker); the default on-demand
             initializer must be removed or WorkManager throws "WorkManager is already
             initialized" the first time anything calls WorkManager.getInstance(). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup.InitializationProvider"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
