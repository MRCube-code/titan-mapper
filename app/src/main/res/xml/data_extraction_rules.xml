<?xml version="1.0" encoding="utf-8"?>
<!--
  Controls what Android Auto Backup and cloud backup sync.
  Exclude the Room database (sensitive key mappings) and DataStore prefs — these are
  exported manually by the user via the in-app Backup Manager (AES-256-GCM encrypted).
  See ARCHITECTURE.md §12 (Security Model).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="titan_database" />
        <exclude domain="sharedpref" path="titan_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="titan_database" />
        <exclude domain="sharedpref" path="titan_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
