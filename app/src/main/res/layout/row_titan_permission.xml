<?xml version="1.0" encoding="utf-8"?>
<!-- One "Required Permission" row: label + "?" help badge + status icon (shown/hidden by code). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:background="@drawable/bg_titan_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/rowLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/titan_text_white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/rowHelpBadge"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_titan_circle_dark"
        android:gravity="center"
        android:text="@string/help_question_mark"
        android:textColor="@color/titan_text_white"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/rowStatusIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_titan_check"
        android:visibility="invisible"
        android:contentDescription="@null" />

    <Button
        android:id="@+id/rowActionButton"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_titan_button"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/permissions_grant_button"
        android:textAllCaps="true"
        android:textColor="@color/titan_text_white"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
