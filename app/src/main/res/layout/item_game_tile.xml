<?xml version="1.0" encoding="utf-8"?>
<!-- One small "added game" tile in the horizontal row. Inflated/bound in code; no new
     dependency on RecyclerView for what's usually a handful of items. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="72dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/gameTileIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_titan_tile"
        android:padding="8dp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/gameTileLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/titan_text_on_light"
        android:textSize="11sp" />
</LinearLayout>
