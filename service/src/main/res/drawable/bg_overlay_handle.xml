<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed drag handle, and the small grip bar atop the expanded panel: a dashed-edge circle,
     matching the reference screenshot's draggable handle indicator. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@color/overlay_handle_fill" />
    <stroke
        android:width="2dp"
        android:color="@color/overlay_handle_stroke"
        android:dashWidth="6dp"
        android:dashGap="4dp" />
</shape>
