    <color name="overlay_panel_navy">#E62C2A45</color>
    <color name="overlay_button_indigo">#5457B8</color>
    <color name="overlay_hex_indigo">#4B4EA8</color>
    <color name="overlay_hex_stroke">#8B8FE6</color>
    <color name="overlay_stats_bg">#3C3F8E</color>
    <color name="overlay_text_white">#FFFFFF</color>
</resources>
